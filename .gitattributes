# ==========================================
# Global Settings (Handle Line Endings)
# ==========================================
# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# ==========================================
# Source Code (Force LF)
# ==========================================
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.graphql text eol=lf

# ==========================================
# Styles and Markups
# ==========================================
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.mdx text eol=lf

# ==========================================
# Configurations
# ==========================================
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.prettierrc text eol=lf
.eslintrc* text eol=lf

# ==========================================
# Binary Files (Do not alter line endings)
# ==========================================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.webp binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary

# ==========================================
# Git/GitHub Visual Enhancements
# ==========================================
# Treat lockfiles as auto-generated/binary to hide huge diffs on GitHub
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true